@startuml
skinparam classAttributeIconSize 0

class Member4 {
  -username : String
  -password : String
  -fullName : String
  -dateOfBirth : Date
  -email : String
  -phone : String
  -address : String
}
class Employee4 { 
    -position : String 
    }
class Manager4

class "CinemaInterface4.jsp" as CinemaInterface4 {
  -subManageMovieInformation4 : submit
  -subManageShowTime4 : submit
  -subManageScreeningRoom4 : submit
  -subViewStatistic4 : submit
}
class "ManageMovieInterface4.jsp" as ManageMovieInterface4 {
  -subAddMovieInformation4 : submit
  -subEditMovieInformation4 : submit
  -subDeleteMovieInformation4 : submit
  -tblListMovie4 : Table
  -subBack : submit
}
class "AddMovieInterface4.jsp" as AddMovieInterface4 {
  -inName : string
  -inGenre : string
  -inDuration : string
  -inDescription : string
  -subAddMovie4 : submit
  -subBack : submit
}

class DAO {
  -con : Connection()
  +DAO()
}
class MovieDAO4 {
  +MovieDAO4()
  +addMovie4(movie : Movie4) : boolean
  +updateMovie(movie : Movie4) : boolean
  +deleteMovie(movieId : String) : boolean()
  +getMovieById(movieId : String) : Movie4()
  +getAllMovies() : List<Movie4>
}
class Movie4 {
  -movieId : String
  -movieName : String
  -genre : String
  -duration : int
  -description : String
  +addMovie4(movie : Movie4) : boolean
  +updateMovie(movie : Movie4) : boolean
  +deleteMovie(movieId : String) : boolean()
  +getMovieById(movieId : String) : Movie4()
  +getAllMovies() : List<Movie4>
}

Employee4 --|> Member4
Manager4 --|> Employee4
MovieDAO4 --|> DAO

Manager4 -- CinemaInterface4
CinemaInterface4 -- ManageMovieInterface4
ManageMovieInterface4 -- AddMovieInterface4
AddMovieInterface4 -- MovieDAO4
MovieDAO4 -- Movie4
@enduml