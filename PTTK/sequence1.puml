@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam monochrome true
autonumber "<b>0:"

actor "Manager4" as Actor
boundary "CinemaInterface4" as UI1
boundary "ManageMovieInterface4" as UI2
boundary "AddMovieInterface4" as UI3
control "Movie4DAO" as DAO
entity "Movie4" as Entity

activate Actor
Actor -> UI1 : chon QL phim
activate UI1
UI1 -> UI2 : goi
activate UI2
UI2 --> Actor : hien thi

Actor -> UI2 : chon them phim
UI2 -> UI3 : goi
activate UI3
UI3 --> Actor : hien thi

Actor -> UI3 : nhap TT phim + click Them
UI3 -> Entity : goi
activate Entity
Entity -> Entity : setter()
activate Entity
deactivate Entity
Entity --> UI3 : tra ve
deactivate Entity

UI3 -> DAO : goi
activate DAO
DAO -> DAO : addMovie4(movie)
activate DAO
deactivate DAO
DAO --> UI3 : tra ve
deactivate DAO

UI3 --> Actor : thong bao thanh cong
Actor -> UI3 : click OK
UI3 -> UI1 : goi
deactivate UI3
deactivate UI2
UI1 --> Actor : hien thi
deactivate UI1
deactivate Actor
@enduml